{
  "name": "@tabsircg/analytics",
  "version": "2.2.0",
  "description": "Analytics tracker",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "tc": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "files": [
    "dist",
    "global.d.ts",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./global.d.ts",
      "default": "./dist/cgd.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "source": "./src/sdk.ts",
      "import": "./dist/sdk.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "source": "./src/react.tsx",
      "import": "./dist/react.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "source": "./src/middleware/index.ts",
      "import": "./dist/middleware.js"
    },
    "./global": "./global.d.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tabsircg/schemas": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "happy-dom": "^20.11.1",
    "prettier": "^3.0.0",
    "react": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}

{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "NODE_OPTIONS=--max-old-space-size=2048 next dev --turbopack -H 0.0.0.0 -p 5000",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "dev": "pnpm run \"/^(dev:server|emulators)$/\"",
    "build": "next build",
    "start": "next start -p 5000",
    "lint": "eslint src",
    "tc": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "tsc --noEmit",
    "dev:clean": "rm -rf .next .vercel && pnpm dev",
    "cil": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "typecheck": "tsc -b && rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@devicon/react": "^0.0.3",
    "@open-notion/editor": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@tabsircg/schemas": "workspace:*",
    "@tabsircg/analytics": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "firebase-admin": "^12.7.0",
    "jose": "^6.2.3",
    "motion": "^12.42.2",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "premium-ds": "^0.7.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^3.8.1",
    "sharp": "catalog:",
    "swr": "^2.4.1",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "prettier": "^3.8.3",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.63.0"
  }
}

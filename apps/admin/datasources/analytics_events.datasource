SCHEMA >
    website_id String `json:$.website_id`,
    type String `json:$.type`,
    domain String `json:$.domain`,
    href String `json:$.href`,
    referrer String `json:$.referrer`,
    visitor_id String `json:$.visitor_id`,
    session_id String `json:$.session_id`,
    language String `json:$.language`,
    timezone String `json:$.timezone`,
    event_name String `json:$.event_name`,
    extra_data String `json:$.extra_data`,
    country String `json:$.country`,
    region String `json:$.region`,
    city String `json:$.city`,
    user_agent String `json:$.user_agent`,
    ip String `json:$.ip`,
    viewport_w Float64 `json:$.viewport_w`,
    viewport_h Float64 `json:$.viewport_h`,
    screen_w Float64 `json:$.screen_w`,
    screen_h Float64 `json:$.screen_h`,
    session_number Float64 `json:$.session_number`,
    timestamp Int64 `json:$.timestamp`

ENGINE "MergeTree"
ENGINE_SORTING_KEY "website_id, timestamp"

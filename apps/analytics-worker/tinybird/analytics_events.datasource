SCHEMA >
    website_id String `json:$.website_id`,
    type String `json:$.type`,
    domain String `json:$.domain` DEFAULT 'unknown',
    href String `json:$.href` DEFAULT '',
    referrer String `json:$.referrer` DEFAULT '',
    visitor_id UUID `json:$.visitor_id` DEFAULT toUUID('00000000-0000-0000-0000-000000000000'),
    session_id UUID `json:$.session_id` DEFAULT toUUID('00000000-0000-0000-0000-000000000000'),
    language String `json:$.language` DEFAULT '',
    timezone String `json:$.timezone` DEFAULT '',
    event_name String `json:$.event_name` DEFAULT type,
    extra_data String `json:$.extra_data` DEFAULT '{}',
    country String `json:$.country` DEFAULT 'Unknown',
    region String `json:$.region` DEFAULT 'Unknown',
    city String `json:$.city` DEFAULT 'Unknown',
    browser String `json:$.browser` DEFAULT '',
    os String `json:$.os` DEFAULT '',
    device String `json:$.device` DEFAULT '',
    is_bot UInt8 `json:$.is_bot` DEFAULT 0,
    bot_category String `json:$.bot_category` DEFAULT '',
    bot_name String `json:$.bot_name` DEFAULT '',
    ip String `json:$.ip` DEFAULT '',
    viewport_w UInt16 `json:$.viewport_w` DEFAULT 0,
    viewport_h UInt16 `json:$.viewport_h` DEFAULT 0,
    screen_w UInt16 `json:$.screen_w` DEFAULT 0,
    screen_h UInt16 `json:$.screen_h` DEFAULT 0,
    session_number UInt16 `json:$.session_number` DEFAULT 0,
    revenue_cents Int64 `json:$.revenue_cents` DEFAULT 0,
    timestamp Int64 `json:$.timestamp`

INDEXES >
    INDEX idx_visitor_id visitor_id TYPE bloom_filter(0.01) GRANULARITY 4

ENGINE "MergeTree"
ENGINE_SORTING_KEY "website_id, is_bot, type, timestamp"

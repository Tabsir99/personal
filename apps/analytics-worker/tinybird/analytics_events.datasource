SCHEMA >
    website_id String `json:$.website_id`,
    type String `json:$.type`,
    domain String `json:$.domain`,
    href String `json:$.href`,
    referrer String `json:$.referrer`,
    visitor_id String `json:$.visitor_id`,
    session_id String `json:$.session_id`,
    language String `json:$.language`,
    timezone String `json:$.timezone`,
    event_name String `json:$.event_name`,
    extra_data String `json:$.extra_data`,
    country String `json:$.country`,
    region String `json:$.region`,
    city String `json:$.city`,
    browser String `json:$.browser`,
    os String `json:$.os`,
    device String `json:$.device`,
    is_bot UInt8 `json:$.is_bot`,
    bot_category String `json:$.bot_category`,
    bot_name String `json:$.bot_name`,
    ip String `json:$.ip`,
    viewport_w UInt16 `json:$.viewport_w`,
    viewport_h UInt16 `json:$.viewport_h`,
    screen_w UInt16 `json:$.screen_w`,
    screen_h UInt16 `json:$.screen_h`,
    session_number UInt16 `json:$.session_number`,
    revenue_cents Int64 `json:$.revenue_cents`,
    timestamp Int64 `json:$.timestamp`

ENGINE "MergeTree"
ENGINE_SORTING_KEY "website_id, is_bot, type, timestamp"
